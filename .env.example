# Copy to .env and fill in. The service starts without a key;
# preflight then refuses to spend (ask_clarify).

TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
REMAINING_BUDGET_USD=0.05
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL_LITE=gemini-3.1-flash-lite-image
GEMINI_IMAGE_MODEL_PREMIUM=gemini-3-pro-image-preview
